# Server-side only. Never rename these values with a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=your_key_here  # from Google AI Studio
GEMINI_MODEL=gemini-2.5-flash
ADMIN_SECRET=  # generate with: openssl rand -base64 32
SESSION_SECRET=  # generate with: openssl rand -base64 32
ENABLE_RESUME_TOOLS=false  # set to true to enable the private resume tools
